// Cloudflare Workers settings: serve the built Astro site (dist/) as static files.
{
  "name": "seotrendnow",
  "compatibility_date": "2026-09-01",
  // Small script that redirects www.seotrendnow.online to seotrendnow.online (see worker/index.js)
  "main": "./worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    // Run the redirect check on pages only. CSS, JS, fonts and images (/_astro/*) are served directly.
    "run_worker_first": ["/*", "!/_astro/*"]
  },
  // Live domains. These routes catch all traffic to the domain through the existing
  // proxied (orange-cloud) DNS records in the seotrendnow.online zone.
  "routes": [
    { "pattern": "seotrendnow.online/*", "zone_name": "seotrendnow.online" },
    { "pattern": "www.seotrendnow.online/*", "zone_name": "seotrendnow.online" }
  ],
  // Keep the backup seotrendnow.<account>.workers.dev address working
  "workers_dev": true
}

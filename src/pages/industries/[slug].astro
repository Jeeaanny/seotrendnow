---
// One page per industry: /industries/dental-seo/, /industries/home-services-seo/, /industries/law-firm-seo/
// Copy lives in src/data/industries.ts
import BaseLayout from '../../layouts/BaseLayout.astro';
import { INDUSTRY_PAGES, type IndustryPage } from '../../data/industries';
import { getPosts } from '../../lib/content';
import { CALENDLY, SITE, SERVICES } from '../../consts';
import { servicesCss } from '../../styles/page-css';
import { Image } from 'astro:assets';
import hvacTech from '../../assets/industries/hvac-technician-testing-ac-unit.webp';
import electrician from '../../assets/industries/electrician-working-on-electrical-panel.webp';
import plumber from '../../assets/industries/plumber-installing-toilet-flush-plate.webp';
import plasterer from '../../assets/industries/plasterer-finishing-interior-wall.webp';
const HERO_IMAGES = { hvac: hvacTech } as const;
const GALLERY_IMAGES = { electrician, plumber, plasterer } as const;

export function getStaticPaths() {
  return INDUSTRY_PAGES.map((i) => ({ params: { slug: i.slug }, props: { d: i } }));
}
const { d } = Astro.props as { d: IndustryPage };
const others = INDUSTRY_PAGES.filter((o) => o.slug !== d.slug);
const guide = d.guide ? (await getPosts()).find((p) => p.id === d.guide) : undefined;
const url = new URL(`/industries/${d.slug}/`, SITE.domain).href;
const hero = d.heroImage ? HERO_IMAGES[d.heroImage.key as keyof typeof HERO_IMAGES] : undefined;

const schema = [
  {
    '@context': 'https://schema.org', '@type': 'Service', name: d.name, url, description: d.description,
    serviceType: d.serviceType, provider: { '@id': `${SITE.domain}/#business`, '@type': 'ProfessionalService', name: SITE.name, url: `${SITE.domain}/` },
    areaServed: ['United States', 'Australia', 'Singapore', 'Philippines'],
  },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: d.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
const extraCss = `.q{background:#FFFFFF;border:1px solid #DDE1FF;border-radius:16px;padding:20px 24px}.q h3{margin:0;font-family:Inter,system-ui,sans-serif;font-weight:700;color:#0B2A6F;font-size:18px;line-height:1.4}.q p{margin:12px 0 0}
.pain{background:#FFFFFF;border:1px solid #DDE1FF;border-radius:20px;padding:26px 26px 24px;display:flex;flex-direction:column;gap:16px}
.pain h3{margin:0;font-family:Archivo,system-ui,sans-serif;font-weight:800;font-size:20px;line-height:1.3;color:#0B2A6F}
.rows{display:grid;grid-template-columns:76px 1fr;gap:10px 12px;margin:0;font-size:16px;line-height:1.5}
.rows dt{font-weight:700;font-size:14px;padding-top:2px}.rows dd{margin:0}
.rows .fx{color:#3354FF}.rows .rs{color:#13914A}.rows .wy{color:#334969}.rows dd.wy-t{color:#334969}
.badge{align-self:flex-start;margin-top:auto;display:inline-flex;align-items:center;gap:6px;background:#FFCA00;color:#001C44;font-weight:700;font-size:14px;padding:7px 14px;border-radius:100px;text-decoration:none}
.badge:hover{filter:brightness(1.05)}`;
---
<BaseLayout title={d.title} description={d.description} schema={schema}
  breadcrumb={[{ name: 'Services', url: '/services/' }, { name: d.name, url: `/industries/${d.slug}/` }]}>
<Fragment slot="head"><style is:inline set:html={servicesCss + extraCss}></style></Fragment>

<section style="background: #0B2A6F; color: #FFFFFF">
<div class="wrap" style="display: flex; flex-wrap: wrap; align-items: center; gap: 48px; padding-top: 56px; padding-bottom: 80px">
<div style={`flex: 1 1 520px; min-width: 0; display: flex; flex-direction: column; gap: 22px${hero ? '' : '; max-width: 860px'}`}>
<nav aria-label="Breadcrumb" style="font-size: 14px; color: #CBD1D9"><a href="/" style="color: #CBD1D9; text-decoration: none">Home</a> <span aria-hidden="true">›</span> <a href="/services/" style="color: #CBD1D9; text-decoration: none">Services</a> <span aria-hidden="true">›</span> <span style="color: #FFFFFF; font-weight: 600">{d.menuLabel}</span></nav>
<h1 class="h1" style="color: #FFFFFF">{d.h1}</h1>
<p style="margin: 0; font-size: 19px; color: #CBD1D9; max-width: 720px">{d.intro}</p>
<div style="display: flex; flex-wrap: wrap; gap: 14px; padding-top: 6px">
<a class="pill" href={CALENDLY} target="_blank" rel="noopener" style="background: #3354FF; color: #FFFFFF">Book a Free Strategy Call</a>
<a class="pill" href="#proof" style="background: transparent; color: #FFFFFF; border: 2px solid rgba(255,255,255,0.35)">See the Results</a>
</div>
</div>
{hero && d.heroImage && (
<div style="flex: 1 1 420px; min-width: 0">
<Image src={hero} alt={d.heroImage.alt} widths={[480, 720, 960, 1280]} sizes="(min-width: 1060px) 520px, 100vw" loading="eager" fetchpriority="high" style="width: 100%; height: auto; aspect-ratio: 3 / 2; object-fit: cover; display: block; border-radius: 28px; box-shadow: 0 24px 60px rgba(0,10,40,0.35)" />
</div>
)}
</div>
</section>

<section class="sec" style="background: #F9FAFF">
<div class="wrap" style="display: flex; flex-direction: column; gap: 40px">
<h2 class="h2" style="color: #0B2A6F; max-width: 820px">{d.painHeading}</h2>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr)); gap: 20px">
{d.pains.map((p) => (
<article class="pain">
<h3>“{p.pain}”</h3>
<dl class="rows">
<dt class="fx">The fix</dt><dd>{p.fix}</dd>
<dt class="rs">Result</dt><dd>{p.result}</dd>
<dt class="wy">Why</dt><dd class="wy-t">{p.why}</dd>
</dl>
{p.proof && <a class="badge" href={`/results/${p.proof.caseId}/`}>Proof: {p.proof.label} →</a>}
</article>
))}
</div>
</div>
</section>

{d.gallery && (
<section style="background: #FFFFFF">
<div class="wrap" style="display: flex; flex-direction: column; gap: 28px; padding-top: 80px; padding-bottom: 8px">
<h2 class="h2" style="color: #0B2A6F">{d.gallery.heading}</h2>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr)); gap: 20px">
{d.gallery.items.map((g) => (
<figure style="margin: 0; display: flex; flex-direction: column; gap: 12px">
<Image src={GALLERY_IMAGES[g.key as keyof typeof GALLERY_IMAGES]} alt={g.alt} widths={[400, 600, 800]} sizes="(min-width: 1060px) 360px, 100vw" style="width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; display: block; border-radius: 20px" />
<figcaption style="font-family: Archivo, system-ui, sans-serif; font-weight: 800; font-size: 19px; color: #0B2A6F">{g.label}</figcaption>
</figure>
))}
</div>
</div>
</section>
)}

{d.extra && (
<section class="sec" style="background: #FFFFFF">
<div class="wrap" style="display: flex; flex-wrap: wrap; gap: 48px; align-items: center">
<div style="flex: 2 1 520px; min-width: 0; display: flex; flex-direction: column; gap: 16px">
<h2 class="h2" style="color: #0B2A6F">{d.extra.heading}</h2>
{d.extra.text.map((t) => <p style="margin: 0; font-size: 18px">{t}</p>)}
</div>
<a href={`/results/${d.extra.stat.caseId}/`} style="flex: 1 1 280px; min-width: 0; text-decoration: none; background: #F0F2FF; border-radius: 24px; padding: 32px; display: flex; flex-direction: column; gap: 10px">
<span style="font-family: Archivo, system-ui, sans-serif; font-weight: 800; font-size: 52px; line-height: 1; color: #3354FF">{d.extra.stat.value}</span>
<span style="color: #0B2A6F; font-weight: 600">{d.extra.stat.label}</span>
<span style="font-weight: 700; color: #3354FF; font-size: 15px">Read the case study →</span>
</a>
</div>
</section>
)}

<section id="proof" class="sec" style="background: #0B2A6F; color: #FFFFFF">
<div class="wrap" style="display: flex; flex-direction: column; gap: 36px">
<div style="display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 20px">
<h2 class="h2" style="color: #FFFFFF">{d.proofHeading}</h2>
<a href="/results/" style="font-weight: 700; color: #FFCA00; text-decoration: none">All case studies →</a>
</div>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr)); gap: 20px">
{d.proof.map((s, i) => (
<a href={`/results/${s.caseId}/`} style="text-decoration: none; background: rgba(255,255,255,0.06); border: 1px solid #334969; border-radius: 20px; padding: 28px; display: flex; flex-direction: column; gap: 10px">
<span style="font-family: Archivo, system-ui, sans-serif; font-weight: 800; font-size: 44px; line-height: 1; color: #FFCA00">{s.value}</span>
<span style="color: #CBD1D9; font-size: 16px">{s.label}</span>
{(i === 0 || d.proof[i - 1].caseId !== s.caseId) && <span style="color: #FFFFFF; font-weight: 700; font-size: 15px; margin-top: auto">Read the case study →</span>}
</a>
))}
</div>
</div>
</section>

<section class="sec" style="background: #FFFFFF">
<div class="wrap" style="display: flex; flex-direction: column; gap: 36px">
<h2 class="h2" style="color: #0B2A6F">How we work.</h2>
<ol style="list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(220px, 100%), 1fr)); gap: 24px">
{d.process.map((p, i) => (
<li style={`display: flex; flex-direction: column; gap: 10px; border-top: 4px solid ${i === d.process.length - 1 ? '#FFCA00' : '#3354FF'}; padding-top: 20px`}>
<span style="font-family: Archivo, system-ui, sans-serif; font-weight: 800; font-size: 34px; color: #DDE1FF; line-height: 1">{String(i + 1).padStart(2, '0')}</span>
<h3 class="h3" style="color: #0B2A6F">{p.title}</h3>
<p style="margin: 0; font-size: 16px">{p.text}</p>
</li>
))}
</ol>
</div>
</section>

<section class="sec" style="background: #F9FAFF">
<div class="wrap" style="display: flex; flex-direction: column; gap: 28px">
<h2 class="h2" style="color: #0B2A6F">Services included.</h2>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr)); gap: 16px">
{SERVICES.map((s) => (
<a href={`/services/${s.slug}/`} style="text-decoration: none; background: #FFFFFF; border: 1px solid #DDE1FF; border-radius: 18px; padding: 22px; color: #0B2A6F; font-weight: 700">{s.label} →</a>
))}
</div>
<a href="/services/#pricing" style="font-weight: 700; text-decoration: none">See packages and starting prices on the Services page →</a>
</div>
</section>

<section class="sec" style="background: #FFFFFF">
<div class="wrap" style="display: flex; flex-wrap: wrap; gap: 48px">
<div style="flex: 1 1 300px; min-width: 0; display: flex; flex-direction: column; gap: 12px">
<h2 class="h2" style="color: #0B2A6F">{d.name} questions.</h2>
</div>
<div style="flex: 2 1 560px; min-width: 0; display: flex; flex-direction: column; gap: 12px">
{d.faqs.map((f) => <div class="q"><h3>{f.q}</h3><p>{f.a}</p></div>)}
</div>
</div>
</section>

<section style="background: #F9FAFF; border-top: 1px solid #EEF0FF">
<div class="wrap" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr)); gap: 16px; padding-top: 56px; padding-bottom: 56px">
{guide && (
<a href={`/blog/${guide.id}/`} style="text-decoration: none; background: #FFFFFF; border: 1px solid #DDE1FF; border-radius: 18px; padding: 22px; display: flex; flex-direction: column; gap: 8px">
<span style="font-size: 13px; font-weight: 700; color: #3354FF; text-transform: uppercase; letter-spacing: .04em">Related guide</span>
<span style="font-family: Archivo, system-ui, sans-serif; font-weight: 800; font-size: 18px; line-height: 1.3; color: #0B2A6F">{guide.data.title}</span>
</a>
)}
{others.map((o) => (
<a href={`/industries/${o.slug}/`} style="text-decoration: none; background: #FFFFFF; border: 1px solid #DDE1FF; border-radius: 18px; padding: 22px; display: flex; flex-direction: column; gap: 8px">
<span style="font-size: 13px; font-weight: 700; color: #3354FF; text-transform: uppercase; letter-spacing: .04em">Other industries</span>
<span style="font-family: Archivo, system-ui, sans-serif; font-weight: 800; font-size: 18px; line-height: 1.3; color: #0B2A6F">{o.name} →</span>
</a>
))}
</div>
</section>

<section style="background: #3354FF; color: #FFFFFF">
<div class="wrap" style="display: flex; flex-direction: column; align-items: center; text-align: center; gap: 18px; padding-top: 88px; padding-bottom: 88px">
<h2 class="h2" style="color: #FFFFFF; max-width: 760px">{d.ctaHeading}</h2>
<p style="margin: 0; font-size: 18px; color: #F0F2FF; max-width: 620px">Book a free 30-minute strategy call. You'll leave with your three biggest opportunities, whether we work together or not.</p>
<a class="pill" href={CALENDLY} target="_blank" rel="noopener" style="background: #FFCA00; color: #001C44; margin-top: 6px">Book a Free Strategy Call</a>
</div>
</section>
</BaseLayout>

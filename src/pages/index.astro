---
// Built from the approved design (Main). Edit the copy directly below.
import BaseLayout from '../layouts/BaseLayout.astro';
import { homeSchema } from '../lib/schema';
import { SHOW_TESTIMONIALS } from '../consts';
import { Image } from 'astro:assets';
import rankGrid from '../assets/google-maps-local-rank-grid.png';
import clicksTrend from '../assets/search-console-organic-clicks-trend.png';
import jeanAtWork from '../assets/jean-jumamoy-seo-strategist-philippines.jpg';
import kitchenGsc from '../content/case-studies/images/kitchen-cabinet-organic-clicks/search-console-organic-clicks-growth.png';
const pageCss = ".sec{padding:104px 0}\n.h1{font-family:Archivo,system-ui,sans-serif;font-weight:800;font-size:64px;line-height:1.04;letter-spacing:-0.02em;margin:0}\n.h2{font-family:Archivo,system-ui,sans-serif;font-weight:800;font-size:46px;line-height:1.08;letter-spacing:-0.015em;margin:0}\n.h3{font-family:Archivo,system-ui,sans-serif;font-weight:800;font-size:22px;line-height:1.2;margin:0}\n.eyebrow{font-family:Kalam,cursive;font-weight:700;font-size:24px;line-height:1.2;margin:0}\n@media (max-width:820px){\n.h1{font-size:42px}.h2{font-size:32px}.sec{padding:72px 0}.wrap{padding:0 16px}\n}";
---
<BaseLayout title={"Local SEO Consultant for Clinics & Law Firms | SEOTrendNow"} description={"Local SEO consultant for clinics, law firms and service businesses in the US, Australia and Singapore. More Google rankings, map-pack visibility and calls."} schema={homeSchema} breadcrumb={undefined}>
<Fragment slot="head"><style is:inline set:html={pageCss}></style><style is:inline>@media (max-width: 600px){.hero-ai{top:64px !important}.ring-outer{inset:-22px !important}.ring-mid{inset:-11px !important}}</style></Fragment>
<section id="top" style="background: #001C44; color: #FFFFFF; overflow: hidden">
<div class="wrap" style="display: flex; flex-wrap: wrap; align-items: center; gap: 56px; padding-top: 96px; padding-bottom: 104px">
<div style="flex: 1 1 520px; min-width: 0; display: flex; flex-direction: column; gap: 24px">

<h1 class="h1" style="color: #FFFFFF">Local SEO Consultant for <span style="background: linear-gradient(transparent 62%, rgba(255,202,0,0.45) 62%)">Clinics, Law Firms and Home Service Businesses</span></h1>
<p style="margin: 0; font-size: 19px; line-height: 1.6; color: #CBD1D9; max-width: 560px">SEO services that fill your calendar, not just your reports. I help clinics, law firms and home service businesses like HVAC, plumbing and roofing companies in the US, Australia and Singapore rank higher on Google, win the map pack and get recommended in AI answers. You work directly with me, from SEO audit to results.</p>
<div style="display: flex; flex-wrap: wrap; gap: 14px; padding-top: 8px">
<a class="pill" href="https://calendly.com/seotrendnow/30min" target="_blank" rel="noopener" style="background: #3354FF; color: #FFFFFF">Book a Free Strategy Call
<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="13 6 19 12 13 18"></polyline></svg></a>
<a class="pill" href="#results" style="background: transparent; color: #FFFFFF; border: 2px solid rgba(255,255,255,0.35)">See the Results</a>
</div>
<div style="display: flex; flex-wrap: wrap; gap: 12px 28px; padding-top: 12px; font-size: 15px; color: #FFFFFF; font-weight: 500">
<span style="display: inline-flex; align-items: center; gap: 8px"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#FFCA00" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 12 10 18 20 6"></polyline></svg>Clients in the US, AU and SG</span>
<span style="display: inline-flex; align-items: center; gap: 8px"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#FFCA00" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 12 10 18 20 6"></polyline></svg>3+ years in healthcare and legal SEO</span>
<span style="display: inline-flex; align-items: center; gap: 8px"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#FFCA00" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 12 10 18 20 6"></polyline></svg>One strategist, no hand-offs</span>
</div>
</div>

<div style="flex: 1 1 420px; min-width: 0; position: relative; min-height: 540px">
<figure style="position: absolute; left: 40px; right: 40px; top: 0; bottom: 40px; margin: 0; border-radius: 28px; overflow: hidden; background: #F7F9F9; box-shadow: 0 24px 60px rgba(0,10,40,0.35)">
<Image src={rankGrid} alt="Google Maps rank grid for a local client: green dots show 41 of 49 search points ranking in the top 3" widths={[480, 640, 960, 1304]} sizes="(min-width: 1060px) 520px, 100vw" loading="eager" fetchpriority="high" style="width: 100%; height: 100%; object-fit: contain; display: block" />
<figcaption style="position: absolute; left: 14px; top: 14px; display: inline-flex; align-items: center; gap: 7px; white-space: nowrap; background: rgba(255,255,255,0.94); color: #001C44; border-radius: 100px; padding: 7px 12px; font-size: 12px; font-weight: 600; box-shadow: 0 6px 16px rgba(0,10,40,0.18)"><span style="width: 10px; height: 10px; border-radius: 50%; background: #13B886"></span>41/49 top 3 on Google Maps</figcaption>
<span style="position: absolute; right: 14px; bottom: 12px; font-size: 10px; color: #4A4A68; background: rgba(255,255,255,0.8); padding: 2px 6px; border-radius: 4px">Map data © Google</span>
</figure>
<div style="position: absolute; left: 0; bottom: 0; width: 280px; background: #FFFFFF; border-radius: 18px; padding: 20px; box-shadow: 0 24px 48px rgba(0,10,40,0.35); color: #001C44; box-sizing: border-box">
<p style="margin: 0; font-size: 13px; font-weight: 600; color: #4A4A68">Organic clicks, Google Search Console</p>
<p style="margin: 4px 0 10px; font-family: Archivo, system-ui, sans-serif; font-weight: 800; font-size: 34px; color: #3354FF; line-height: 1">+120%</p>
<Image src={clicksTrend} alt="Google Search Console chart of organic clicks and impressions rising for a kitchen cabinet supplier" widths={[240, 480]} sizes="240px" style="width: 100%; height: auto; display: block; border-radius: 8px" />
<p style="margin: 8px 0 0; font-size: 13px; color: #4A4A68">Kitchen cabinet supplier, in 6 months</p>
</div>
<div class="hero-ai" style="position: absolute; right: 0; top: 40px; width: 204px; background: #FFFFFF; border-radius: 18px; padding: 18px; box-shadow: 0 24px 48px rgba(0,10,40,0.35); color: #001C44; box-sizing: border-box">
<p style="margin: 0; font-size: 13px; font-weight: 600; color: #4A4A68">ChatGPT recommendation</p>
<p style="margin: 4px 0 12px; font-family: Archivo, system-ui, sans-serif; font-weight: 800; font-size: 34px; color: #3354FF; line-height: 1">#1</p>
<div aria-hidden="true" style="display: flex; flex-direction: column; gap: 9px; font-size: 12px; font-weight: 700">
<span style="display: flex; align-items: center; gap: 8px; color: #001C44">1<span style="flex: none; height: 8px; width: 92px; border-radius: 4px; background: #3354FF"></span><span style="color: #E8A900">★</span>4.9</span>
<span style="display: flex; align-items: center; gap: 8px; color: #808DA1">2<span style="flex: none; height: 8px; width: 110px; border-radius: 4px; background: #DDE1FF"></span></span>
<span style="display: flex; align-items: center; gap: 8px; color: #808DA1">3<span style="flex: none; height: 8px; width: 80px; border-radius: 4px; background: #DDE1FF"></span></span>
</div>
<p style="margin: 12px 0 0; font-size: 13px; color: #4A4A68">Dental clinic in Singapore</p>
</div>
</div>
</div>
</section>

<section style="background: #FFFFFF; border-bottom: 1px solid #EEF0FF">
<div class="wrap" style="display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 20px; padding-top: 36px; padding-bottom: 36px">
<p style="margin: 0; font-size: 14px; font-weight: 600; color: #4A4A68; text-transform: uppercase; letter-spacing: 0.08em">Industries I grow</p>
<div style="display: flex; flex-wrap: wrap; gap: 10px">
<span style="padding: 8px 16px; border-radius: 100px; background: #F0F2FF; color: #001C44; font-weight: 600; font-size: 15px">Healthcare &amp; Clinics</span>
<span style="padding: 8px 16px; border-radius: 100px; background: #F0F2FF; color: #001C44; font-weight: 600; font-size: 15px">Dental</span>
<span style="padding: 8px 16px; border-radius: 100px; background: #F0F2FF; color: #001C44; font-weight: 600; font-size: 15px">Legal</span>
<span style="padding: 8px 16px; border-radius: 100px; background: #F0F2FF; color: #001C44; font-weight: 600; font-size: 15px">Wellness</span>
<span style="padding: 8px 16px; border-radius: 100px; background: #F0F2FF; color: #001C44; font-weight: 600; font-size: 15px">Home Services</span>
<span style="padding: 8px 16px; border-radius: 100px; background: #F0F2FF; color: #001C44; font-weight: 600; font-size: 15px">Home Builders</span>
</div>
</div>
</section>

<section class="sec" style="background: #F9FAFF">
<div class="wrap" style="display: flex; flex-direction: column; gap: 48px">
<div style="display: flex; flex-direction: column; gap: 12px; max-width: 760px">

<h2 class="h2" style="color: #001C44">You're Paying for SEO. The Phone Still Isn't Ringing.</h2>
</div>

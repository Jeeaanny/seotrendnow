---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CALENDLY } from '../consts';
const css = `.h1{font-family:Archivo,system-ui,sans-serif;font-weight:800;font-size:56px;line-height:1.05;letter-spacing:-0.02em;margin:0}@media(max-width:820px){.h1{font-size:38px}}`;
---
<BaseLayout title="Page Not Found | SEOTrendNow" description="This page doesn't exist. Head back to the homepage or browse SEO services, results and the blog." noindex>
<Fragment slot="head"><style is:inline set:html={css}></style></Fragment>
<section style="background: #001C44; color: #FFFFFF">
  <div class="wrap" style="padding-top: 120px; padding-bottom: 120px; display: flex; flex-direction: column; gap: 20px; align-items: center; text-align: center">
    <p class="eyebrow" style="color: #FFCA00">404</p>
    <h1 class="h1" style="color: #FFFFFF">This page dropped out of the index.</h1>
    <p style="margin: 0; font-size: 19px; color: #CBD1D9; max-width: 560px">The link may be old or mistyped. Here are the best places to go next.</p>
    <div style="display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; padding-top: 8px">
      <a class="pill" href="/" style="background: #FFCA00; color: #001C44">Go to Homepage</a>
      <a class="pill" href="/services/" style="background: transparent; color: #FFFFFF; border: 2px solid rgba(255,255,255,0.4)">See Services</a>
      <a class="pill" href={CALENDLY} target="_blank" rel="noopener" style="background: transparent; color: #FFFFFF; border: 2px solid rgba(255,255,255,0.4)">Book a Call</a>
    </div>
  </div>
</section>
</BaseLayout>

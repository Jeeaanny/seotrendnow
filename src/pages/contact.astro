---
// Built from the approved design (Contact). Edit the copy directly below.
import BaseLayout from '../layouts/BaseLayout.astro';
const pageCss = ".h1{font-family:Archivo,system-ui,sans-serif;font-weight:800;font-size:56px;line-height:1.05;letter-spacing:-0.02em;margin:0}\n.h3{font-family:Archivo,system-ui,sans-serif;font-weight:800;font-size:20px;line-height:1.25;margin:0}\n.eyebrow{font-family:Kalam,cursive;font-weight:700;font-size:24px;line-height:1.2;margin:0}\n.lbl{font-weight:600;color:#001C44;font-size:15px}\n.fld{width:100%;box-sizing:border-box;min-height:50px;border:1px solid #CBD1D9;border-radius:12px;padding:12px 16px;font-family:Inter,system-ui,sans-serif;font-size:16px;color:#001C44;background:#FFFFFF}\n.fld:focus{outline:3px solid #AEBBFF;border-color:#3354FF}\n.opt{display:flex;align-items:center;gap:10px;min-height:44px;padding:0 14px;border:1px solid #DDE1FF;border-radius:12px;font-size:15px;color:#001C44;cursor:pointer}\n@media (max-width:820px){.h1{font-size:38px}.wrap{padding:0 16px}}";
---
<BaseLayout title={"Contact an SEO Consultant: Free Strategy Call | SEOTrendNow"} description={"Looking to hire an SEO consultant? Book a free 30-minute SEO strategy call, or reach me on WhatsApp or email. I reply within 24 hours."} schema={[]} breadcrumb={[{ name: 'Contact', url: '/contact/' }]}>
<Fragment slot="head"><style is:inline set:html={pageCss}></style></Fragment>
<section style="background: #001C44; color: #FFFFFF">
<div class="wrap" style="display: flex; flex-direction: column; gap: 18px; padding-top: 80px; padding-bottom: 150px">

<h1 class="h1" style="color: #FFFFFF; max-width: 820px">Contact an SEO Consultant: Book Your Free Strategy Call</h1>
<p style="margin: 0; font-size: 19px; color: #CBD1D9; max-width: 620px">Tell me about your business and what you want from SEO. I'll reply with first thoughts and next steps, usually within 24 hours.</p>
</div>
</section>

<section style="background: #F9FAFF">
<div class="wrap" style="display: flex; flex-wrap: wrap; gap: 32px; align-items: flex-start; margin-top: -96px; padding-bottom: 96px">

<form id="contact-form" data-ajax data-success-title="Thanks, your message is in." data-success-text="I&#39;ll reply with first thoughts and next steps soon. Want to talk sooner? Use the Book a Strategy Call button on this page." action="https://formspree.io/f/xljjajey" method="POST" style="flex: 1 1 600px; min-width: 0; background: #FFFFFF; border-radius: 28px; padding: 40px; box-shadow: 0 24px 60px rgba(0,28,68,0.12); display: flex; flex-direction: column; gap: 22px; box-sizing: border-box">
<div style="display: flex; flex-direction: column; gap: 6px">
<h2 class="h3" style="color: #001C44; font-size: 26px">Send me a message</h2>
<p style="margin: 0; font-size: 15px">Fields marked * are required.</p>
</div>
<input type="hidden" name="_subject" value="New enquiry from seotrendnow.online">
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 18px">
<div style="display: flex; flex-direction: column; gap: 8px"><label class="lbl" for="c-name">Full name *</label><input class="fld" id="c-name" name="name" type="text" autocomplete="name" required=""></div>
<div style="display: flex; flex-direction: column; gap: 8px"><label class="lbl" for="c-email">Work email *</label><input class="fld" id="c-email" name="email" type="email" autocomplete="email" required=""></div>
<div style="display: flex; flex-direction: column; gap: 8px"><label class="lbl" for="c-site">Website</label><input class="fld" id="c-site" name="website" type="url" placeholder="https://"></div>
<div style="display: flex; flex-direction: column; gap: 8px"><label class="lbl" for="c-country">Where is your business based?</label>
<input class="fld" id="c-country" name="country" type="text" autocomplete="country-name" placeholder="Where your business is based" /></div>
</div>
<div style="display: flex; flex-direction: column; gap: 8px"><label class="lbl" for="c-industry">Industry</label>
<select class="fld" id="c-industry" name="industry"><option value="">Select one</option><option>Healthcare &amp; clinics</option><option>Dental</option><option>Legal</option><option>Wellness</option><option>Home services</option><option>Home builders</option><option>Other</option></select></div>
<fieldset style="margin: 0; padding: 0; border: 0; display: flex; flex-direction: column; gap: 10px">
<legend class="lbl" style="padding: 0; margin-bottom: 10px">What do you need help with?</legend>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 10px">
<label class="opt"><input type="checkbox" name="help" value="Local SEO &amp; GBP" style="width: 18px; height: 18px; accent-color: #3354FF">Local SEO &amp; GBP</label>
<label class="opt"><input type="checkbox" name="help" value="Technical SEO &amp; Schema" style="width: 18px; height: 18px; accent-color: #3354FF">Technical SEO &amp; Schema</label>
<label class="opt"><input type="checkbox" name="help" value="Keyword &amp; Content Strategy" style="width: 18px; height: 18px; accent-color: #3354FF">Keyword &amp; Content Strategy</label>
<label class="opt"><input type="checkbox" name="help" value="AI Search Visibility" style="width: 18px; height: 18px; accent-color: #3354FF">AI Search Visibility</label>
<label class="opt"><input type="checkbox" name="help" value="SEO Audit" style="width: 18px; height: 18px; accent-color: #3354FF">One-time SEO audit</label>
<label class="opt"><input type="checkbox" name="help" value="Not sure yet" style="width: 18px; height: 18px; accent-color: #3354FF">Not sure yet</label>
</div>
</fieldset>
<div style="display: flex; flex-direction: column; gap: 8px"><label class="lbl" for="c-msg">Tell me about your goals *</label><textarea class="fld" id="c-msg" name="message" rows="5" required="" placeholder="What's working, what isn't, and what would success look like in 6 months?" style="min-height: 140px; resize: vertical"></textarea></div>
<input type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" style="display: none">
<div style="display: flex; flex-wrap: wrap; align-items: center; gap: 16px 24px">
<button type="submit" class="pill" style="background: #3354FF; color: #FFFFFF">Send Message
<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="13 6 19 12 13 18"></polyline></svg></button>
<p style="margin: 0; font-size: 14px">Your details are only used to reply to you.</p>
</div>
</form><aside style="flex: 1 1 340px; min-width: 0; display: flex; flex-direction: column; gap: 20px">
<div id="book" style="background: #3354FF; color: #FFFFFF; border-radius: 24px; padding: 32px; display: flex; flex-direction: column; gap: 12px">
<span style="display: inline-flex; width: 48px; height: 48px; border-radius: 14px; background: rgba(255,255,255,0.16); align-items: center; justify-content: center"><svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="2"></rect><line x1="3" y1="10" x2="21" y2="10"></line><line x1="8" y1="3" x2="8" y2="7"></line><line x1="16" y1="3" x2="16" y2="7"></line></svg></span>
<h2 class="h3" style="color: #FFFFFF; font-size: 22px">Prefer to talk? Book a free 30-minute call.</h2>
<p style="margin: 0; color: #F0F2FF; font-size: 15px">Pick a time that suits your time zone. You'll leave with your three biggest SEO opportunities.</p>
<a class="pill" href="https://calendly.com/seotrendnow/30min" target="_blank" rel="noopener" style="background: #FFCA00; color: #001C44; align-self: flex-start; margin-top: 4px">Book a Strategy Call</a>
</div>

<div style="background: #FFFFFF; border: 1px solid #DDE1FF; border-radius: 24px; padding: 28px; display: flex; flex-direction: column; gap: 18px">
<a href="https://wa.me/639919311502" target="_blank" rel="noopener noreferrer" style="display: flex; gap: 14px; align-items: center; text-decoration: none; color: inherit">
<span style="flex: none; display: inline-flex; width: 44px; height: 44px; border-radius: 12px; background: #F0F2FF; align-items: center; justify-content: center"><svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#3354FF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z"></path></svg></span>
<span style="font-size: 15px; line-height: 1.4"><b style="color: #001C44; display: block">WhatsApp</b>+63 9919311502</span>
</a>
<a href="mailto:seotrendnow@gmail.com" style="display: flex; gap: 14px; align-items: center; text-decoration: none; color: inherit">
<span style="flex: none; display: inline-flex; width: 44px; height: 44px; border-radius: 12px; background: #F0F2FF; align-items: center; justify-content: center"><svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#3354FF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"></rect><polyline points="3 7 12 13 21 7"></polyline></svg></span>
<span style="font-size: 15px; line-height: 1.4"><b style="color: #001C44; display: block">Email</b>seotrendnow@gmail.com</span>
</a>
<div style="display: flex; gap: 14px; align-items: center">
<span style="flex: none; display: inline-flex; width: 44px; height: 44px; border-radius: 12px; background: #F0F2FF; align-items: center; justify-content: center"><svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#3354FF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><polyline points="12 7 12 12 15 14"></polyline></svg></span>
<span style="font-size: 15px; line-height: 1.4"><b style="color: #001C44; display: block">Working hours</b>Based in the Philippines, working with clients across time zones</span>
</div>
</div>

<div style="background: #FFFFFF; border: 1px solid #DDE1FF; border-radius: 24px; padding: 28px; display: flex; flex-direction: column; gap: 16px">
<h2 class="h3" style="color: #001C44">What happens next</h2>
<div style="display: flex; gap: 14px"><span style="flex: none; font-family: Archivo, system-ui, sans-serif; font-weight: 800; font-size: 20px; color: #3354FF; width: 28px">1</span><p style="margin: 0; font-size: 15px">I look at your site, Google Business Profile and top competitors.</p></div>
<div style="display: flex; gap: 14px"><span style="flex: none; font-family: Archivo, system-ui, sans-serif; font-weight: 800; font-size: 20px; color: #3354FF; width: 28px">2</span><p style="margin: 0; font-size: 15px">I reply with first thoughts and the opportunities I see.</p></div>
<div style="display: flex; gap: 14px"><span style="flex: none; font-family: Archivo, system-ui, sans-serif; font-weight: 800; font-size: 20px; color: #3354FF; width: 28px">3</span><p style="margin: 0; font-size: 15px">If it looks like a fit, we book a call to plan the work.</p></div>
</div>
</aside>
</div>
</section>

<script>import "../scripts/contact-form.ts";</script>
</BaseLayout>

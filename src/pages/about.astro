---
// Built from the approved design (About). Edit the copy directly below.
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import jeanPortrait from '../assets/jean-jumamoy-freelance-seo-specialist.jpg';
import junkGoneLogo from '../assets/junk-gone-hauling-removal-logo.png';
import headHuntableLogo from '../assets/headhuntable-logo.png';
import hiroClinicsLogo from '../assets/hiro-clinics-logo.png';
import aiSeoTrendLogo from '../assets/aiseotrend-local-seo-logo.png';
import cdoBizLogo from '../assets/cdo-biz-logo.svg';
const brands = [
  { name: 'AiSEOTrend', logo: aiSeoTrendLogo },
  { name: 'CDO Biz', logo: cdoBizLogo },
  { name: 'Junk Gone Hauling and Removal', logo: junkGoneLogo },
  { name: 'HeadHuntable', logo: headHuntableLogo },
  { name: 'Hiro Clinics', logo: hiroClinicsLogo },
];
import { aboutSchema } from '../lib/schema';
const pageCss = ".sec{padding:96px 0}\n.h1{font-family:Archivo,system-ui,sans-serif;font-weight:800;font-size:58px;line-height:1.05;letter-spacing:-0.02em;margin:0}\n.h2{font-family:Archivo,system-ui,sans-serif;font-weight:800;font-size:42px;line-height:1.1;letter-spacing:-0.015em;margin:0}\n.h3{font-family:Archivo,system-ui,sans-serif;font-weight:800;font-size:21px;line-height:1.25;margin:0}\n.eyebrow{font-family:Kalam,cursive;font-weight:700;font-size:24px;line-height:1.2;margin:0}\n@media (max-width:820px){.h1{font-size:40px}.h2{font-size:30px}.sec{padding:64px 0}.wrap{padding:0 16px}}";
---
<BaseLayout title={"Jean Jumamoy, Freelance SEO Specialist | SEOTrendNow"} description={"Get more calls from Google. Work directly with a freelance SEO specialist who grows clinics, law firms, and local businesses. Book now!"} schema={aboutSchema} breadcrumb={[{ name: 'About', url: '/about/' }]}>
<Fragment slot="head"><style is:inline set:html={pageCss}></style></Fragment>
<section style="background: #F9FAFF">
<div class="wrap" style="display: flex; flex-wrap: wrap; align-items: center; gap: 64px; padding-top: 88px; padding-bottom: 88px">
<div style="flex: 1 1 520px; min-width: 0; display: flex; flex-direction: column; gap: 22px">

<h1 class="h1" style="color: #001C44">Freelance SEO Specialist for <span style="background: linear-gradient(transparent 62%, rgba(255, 202, 0, 0.55) 62%)">Local Businesses</span></h1>
<p style="margin: 0; font-size: 19px; max-width: 560px">I'm Jean, and I help local businesses get found by people ready to book. I'm a freelance SEO specialist based in the Philippines, working with dental and medical clinics, law firms and home service businesses like HVAC, plumbing and roofing companies. No account managers, no hand-offs. Just me, your data and a clear plan.</p>
<div style="display: flex; flex-wrap: wrap; gap: 14px; padding-top: 6px">
<a class="pill" href="https://calendly.com/seotrendnow/30min" target="_blank" rel="noopener" style="background: #3354FF; color: #FFFFFF">Book a Free Strategy Call</a>
<a class="pill" href="/results/" style="background: #FFFFFF; color: #001C44; border: 2px solid #DDE1FF">See My Results</a>
</div>
</div>
<div style="flex: 1 1 380px; min-width: 0; display: flex; justify-content: center; padding: 28px 28px 36px 24px">
<div style="position: relative; width: 100%; max-width: 400px; aspect-ratio: 4 / 5">
<div aria-hidden="true" style="position: absolute; right: -28px; top: -28px; width: 150px; height: 150px; background-image: radial-gradient(#3354FF 2.2px, transparent 2.4px); background-size: 18px 18px; opacity: 0.45"></div>
<div aria-hidden="true" style="position: absolute; inset: 0; transform: translate(20px, 20px); border: 3px solid #FFCA00; border-radius: 50% 50% 26px 26px / 38% 38% 26px 26px"></div>
<Image src={jeanPortrait} alt="Jean Jumamoy, freelance SEO specialist, working on her laptop" widths={[400, 600, 800]} sizes="(max-width: 600px) 90vw, 400px" loading="eager" fetchpriority="high" style="position: relative; width: 100%; height: 100%; object-fit: cover; object-position: center top; display: block; border-radius: 50% 50% 26px 26px / 38% 38% 26px 26px; box-shadow: 0 24px 48px rgba(0, 28, 68, 0.18)" />
<div style="position: absolute; left: -24px; bottom: 34px; background: #001C44; color: #FFFFFF; border-radius: 18px; padding: 14px 18px; box-shadow: 0 14px 30px rgba(0, 28, 68, 0.28); display: flex; flex-direction: column; gap: 2px">
<span style="font-family: Archivo, system-ui, sans-serif; font-weight: 800; font-size: 18px">Jean Jumamoy</span>
<span style="font-size: 14px; color: #CBD1D9">Freelance SEO Specialist</span>
</div>
<div style="position: absolute; right: -14px; top: 46%; background: #FFCA00; color: #001C44; border-radius: 999px; padding: 8px 14px; font-weight: 700; font-size: 14px; box-shadow: 0 10px 24px rgba(0, 28, 68, 0.18)">3+ years in SEO</div>
</div>
</div>
</div>
</section>

<section style="background: #001C44; color: #FFFFFF">
<div class="wrap" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 32px; padding-top: 48px; padding-bottom: 48px">
<div><p style="margin: 0; font-family: Archivo, system-ui, sans-serif; font-weight: 800; font-size: 36px; color: #FFCA00">3+ years</p><p style="margin: 0; color: #CBD1D9; font-size: 15px">hands-on SEO, agency and freelance</p></div>
<div><p style="margin: 0; font-family: Archivo, system-ui, sans-serif; font-weight: 800; font-size: 36px; color: #FFCA00">1:1</p><p style="margin: 0; color: #CBD1D9; font-size: 15px">you work directly with me, no hand-offs</p></div>
<div><p style="margin: 0; font-family: Archivo, system-ui, sans-serif; font-weight: 800; font-size: 36px; color: #FFCA00">YMYL</p><p style="margin: 0; color: #CBD1D9; font-size: 15px">healthcare, legal and wellness specialist</p></div>
<div><p style="margin: 0; font-family: Archivo, system-ui, sans-serif; font-weight: 800; font-size: 36px; color: #FFCA00">Same day</p><p style="margin: 0; color: #CBD1D9; font-size: 15px">replies to your messages</p></div>
</div>
</section>

<section class="sec" style="background: #FFFFFF">
<div class="wrap" style="display: flex; flex-wrap: wrap; gap: 64px">
<div style="flex: 1 1 340px; min-width: 0; display: flex; flex-direction: column; gap: 12px">

<h2 class="h2" style="color: #001C44">From Building Clinic Websites to Ranking Them.</h2>
</div>
<div style="flex: 2 1 560px; min-width: 0; display: flex; flex-direction: column; gap: 18px">
<p style="margin: 0">I started out designing WordPress sites for a clinic. Beautiful pages kept going nowhere because nobody could find them, so I learned why, and SEO became the job.</p>
<p style="margin: 0">Since then I've provided SEO services for clients in the US, Australia and Singapore, with most of my work in the US. I've written SEO content, run local campaigns for home services and law firms, and managed technical and content work for clinics and wellness brands. Healthcare and legal sites taught me to grow traffic without cutting corners on accuracy or advertising rules.</p>
<p style="margin: 0">I started SEOTrendNow because too many business owners pay for SEO every month and still can't tell if it's working. With me, you talk to the person doing the work, you see every change I make, and you judge the results by one thing: more calls and bookings.</p>
</div>
</div>
</section>

<section class="sec" style="background: #F9FAFF">
<div class="wrap" style="display: flex; flex-direction: column; gap: 44px">
<div style="display: flex; flex-direction: column; gap: 12px; max-width: 720px">

<h2 class="h2" style="color: #001C44">Three things you can count on.</h2>
</div>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px">
<div style="background: #FFFFFF; border: 1px solid #DDE1FF; border-radius: 20px; padding: 32px; display: flex; flex-direction: column; gap: 14px">
<span style="display: inline-flex; width: 48px; height: 48px; border-radius: 14px; background: #3354FF; align-items: center; justify-content: center"><svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 17 9 11 13 15 21 7"></polyline><polyline points="15 7 21 7 21 13"></polyline></svg></span>
<h3 class="h3" style="color: #001C44">Leads over rankings</h3>
<p style="margin: 0">I pick keywords by the bookings they can bring, then report on calls, forms and appointments, not just positions.</p>
</div>
<div style="background: #FFFFFF; border: 1px solid #DDE1FF; border-radius: 20px; padding: 32px; display: flex; flex-direction: column; gap: 14px">
<span style="display: inline-flex; width: 48px; height: 48px; border-radius: 14px; background: #3354FF; align-items: center; justify-content: center"><svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z"></path></svg></span>
<h3 class="h3" style="color: #001C44">The why behind every change</h3>
<p style="margin: 0">You'll always know what I changed, why I changed it and what I expect it to do. No black boxes.</p>
</div>
<div style="background: #FFFFFF; border: 1px solid #DDE1FF; border-radius: 20px; padding: 32px; display: flex; flex-direction: column; gap: 14px">
<span style="display: inline-flex; width: 48px; height: 48px; border-radius: 14px; background: #3354FF; align-items: center; justify-content: center"><svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"></path><polyline points="9 12 11 14 15 10"></polyline></svg></span>
<h3 class="h3" style="color: #001C44">Compliance-first in YMYL</h3>
<p style="margin: 0">Health and legal content gets checked for accuracy and local advertising rules before it goes live.</p>
</div>
</div>
</div>
</section>

<section class="sec" style="background: #FFFFFF">
<div class="wrap" style="display: flex; flex-direction: column; align-items: center; text-align: center; gap: 40px">
<div style="display: flex; flex-direction: column; gap: 12px; max-width: 640px">
<h2 class="h2" style="color: #001C44">Brands I've Worked With</h2>
<p style="margin: 0">Agency, in-house and freelance work for previous clients in the US, Australia and Singapore.</p>
</div>
<ul style="list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 24px 36px">
{brands.map((b) => (
<li>
<Image src={b.logo} alt={`${b.name} logo`} title={b.name} width={96} height={96} widths={[96, 192]} sizes="96px" style="width: 96px; height: 96px; border-radius: 50%; object-fit: cover; display: block; background: #FFFFFF; border: 1px solid #DDE1FF; box-shadow: 0 8px 20px rgba(0, 28, 68, 0.08)" />
</li>
))}
</ul>
</div>
</section>

<section style="background: #F9FAFF">
<div class="wrap" style="display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 24px; padding-top: 56px; padding-bottom: 56px">
<div style="display: flex; flex-direction: column; gap: 6px">

<p style="margin: 0; font-family: Archivo, system-ui, sans-serif; font-weight: 800; font-size: 26px; color: #001C44">The tools behind every audit and report</p>
</div>
<div style="display: flex; flex-wrap: wrap; gap: 10px">
<span style="padding: 10px 18px; border-radius: 100px; background: #FFFFFF; border: 1px solid #DDE1FF; color: #001C44; font-weight: 600; font-size: 15px">Semrush</span>
<span style="padding: 10px 18px; border-radius: 100px; background: #FFFFFF; border: 1px solid #DDE1FF; color: #001C44; font-weight: 600; font-size: 15px">Ahrefs</span>
<span style="padding: 10px 18px; border-radius: 100px; background: #FFFFFF; border: 1px solid #DDE1FF; color: #001C44; font-weight: 600; font-size: 15px">Google Search Console</span>
<span style="padding: 10px 18px; border-radius: 100px; background: #FFFFFF; border: 1px solid #DDE1FF; color: #001C44; font-weight: 600; font-size: 15px">GA4</span>
<span style="padding: 10px 18px; border-radius: 100px; background: #FFFFFF; border: 1px solid #DDE1FF; color: #001C44; font-weight: 600; font-size: 15px">Screaming Frog</span>
<span style="padding: 10px 18px; border-radius: 100px; background: #FFFFFF; border: 1px solid #DDE1FF; color: #001C44; font-weight: 600; font-size: 15px">BrightLocal</span>
</div>
</div>
</section>

<section id="book" style="background: #3354FF; color: #FFFFFF">
<div class="wrap" style="display: flex; flex-direction: column; align-items: center; text-align: center; gap: 18px; padding-top: 88px; padding-bottom: 88px">

<h2 class="h2" style="color: #FFFFFF; max-width: 760px">Want a strategist who knows your industry?</h2>
<p style="margin: 0; color: #F0F2FF; max-width: 560px">Book a free 30-minute call and I'll show you where your search visibility is leaking.</p>
<a class="pill" href="https://calendly.com/seotrendnow/30min" target="_blank" rel="noopener" style="background: #FFCA00; color: #001C44; margin-top: 6px">Book a Free Strategy Call</a>
</div>
</section>
</BaseLayout>

---
// One page per service: /services/local-seo/, /services/technical-seo/, ...
// Copy lives in src/data/services.ts
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SERVICE_PAGES, type ServicePage } from '../../data/services';
import { getCaseStudies, getPosts } from '../../lib/content';
import { CALENDLY, SITE } from '../../consts';
import { servicesCss } from '../../styles/page-css';

export function getStaticPaths() {
  return SERVICE_PAGES.map((s) => ({ params: { slug: s.slug }, props: { s } }));
}
const { s } = Astro.props as { s: ServicePage };
const others = SERVICE_PAGES.filter((o) => o.slug !== s.slug);
const GUIDE_CATEGORY: Record<string, string> = { 'local-seo': 'Local SEO', 'technical-seo': 'Technical SEO', 'content-strategy': 'Content Strategy', 'ai-search-visibility': 'AI Search' };
const PINNED: Record<string, string[]> = { 'local-seo': ['nap-consistency-local-seo'] };
const allPosts = await getPosts();
const pinned = (PINNED[s.slug] ?? []).map((id) => allPosts.find((p) => p.id === id)).filter(Boolean);
const guides = [...pinned, ...allPosts.filter((p) => p.data.category === GUIDE_CATEGORY[s.slug] && !pinned.includes(p))].slice(0, 3);
const cases = (await getCaseStudies()).filter((c) => !c.data.featured && c.data.tags.some((t) => s.caseTags.includes(t))).slice(0, 2);
const url = new URL(`/services/${s.slug}/`, SITE.domain).href;

const schema = [
  {
    '@context': 'https://schema.org', '@type': 'Service', name: s.name, url, description: s.description,
    serviceType: s.name, provider: { '@id': `${SITE.domain}/#business`, '@type': 'ProfessionalService', name: SITE.name, url: `${SITE.domain}/` },
    areaServed: ['United States', 'Australia', 'Singapore', 'Philippines'],
  },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: s.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
const extraCss = `.q{background:#FFFFFF;border:1px solid #DDE1FF;border-radius:16px;padding:20px 24px}.q h3{margin:0;font-family:Inter,system-ui,sans-serif;font-weight:700;color:#001C44;font-size:18px;line-height:1.4}.q p{margin:12px 0 0}
.tag{font-size:13px;font-weight:600;padding:4px 12px;border-radius:100px;background:#F0F2FF;color:#001C44}`;
const check = '<svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#3354FF" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" style="flex: none; margin-top: 4px"><polyline points="4 12 10 18 20 6"></polyline></svg>';
const dot = '<svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#FFCA00" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" style="flex: none; margin-top: 4px"><circle cx="12" cy="12" r="9"></circle><line x1="12" y1="8" x2="12" y2="13"></line><line x1="12" y1="16.5" x2="12" y2="16.5"></line></svg>';
const icons: Record<string, string> = {
  pin: '<path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z"></path><circle cx="12" cy="9.5" r="2.5"></circle>',
  code: '<polyline points="8 7 3 12 8 17"></polyline><polyline points="16 7 21 12 16 17"></polyline><line x1="14" y1="4" x2="10" y2="20"></line>',
  grid: '<rect x="3" y="3" width="7" height="7" rx="1.5"></rect><rect x="14" y="3" width="7" height="7" rx="1.5"></rect><rect x="3" y="14" width="7" height="7" rx="1.5"></rect><rect x="14" y="14" width="7" height="7" rx="1.5"></rect>',
  spark: '<path d="M12 3l1.8 4.7L18.5 9.5l-4.7 1.8L12 16l-1.8-4.7L5.5 9.5l4.7-1.8z"></path><path d="M19 15l.8 2.2L22 18l-2.2.8L19 21l-.8-2.2L16 18l2.2-.8z"></path>',
};
---
<BaseLayout title={s.title} description={s.description} schema={schema}
  breadcrumb={[{ name: 'Services', url: '/services/' }, { name: s.name, url: `/services/${s.slug}/` }]}>
<Fragment slot="head"><style is:inline set:html={servicesCss + extraCss}></style></Fragment>

<section style="background: #001C44; color: #FFFFFF">
<div class="wrap" style="display: flex; flex-wrap: wrap; gap: 48px; align-items: center; padding-top: 56px; padding-bottom: 80px">
<div style="flex: 1 1 600px; min-width: 0; display: flex; flex-direction: column; gap: 22px">
<nav aria-label="Breadcrumb" style="font-size: 14px; color: #CBD1D9"><a href="/" style="color: #CBD1D9; text-decoration: none">Home</a> <span aria-hidden="true">›</span> <a href="/services/" style="color: #CBD1D9; text-decoration: none">Services</a> <span aria-hidden="true">›</span> <span style="color: #FFFFFF; font-weight: 600">{s.menuLabel}</span></nav>
<h1 class="h1" style="color: #FFFFFF">{s.h1}</h1>
<p style="margin: 0; font-size: 19px; color: #CBD1D9; max-width: 640px">{s.intro}</p>
<div style="display: flex; flex-wrap: wrap; gap: 14px; padding-top: 6px">
<a class="pill" href={CALENDLY} target="_blank" rel="noopener" style="background: #3354FF; color: #FFFFFF">Book a Free Strategy Call</a>
<a class="pill" href="/contact/" style="background: transparent; color: #FFFFFF; border: 2px solid rgba(255,255,255,0.35)">Send a Message</a>
</div>
</div>
<div style="flex: 0 1 300px; min-width: 0; display: flex; justify-content: center">
<span style="display: inline-flex; width: 160px; height: 160px; border-radius: 40px; background: #3354FF; align-items: center; justify-content: center; box-shadow: 0 24px 48px rgba(0,0,0,0.3)"><svg aria-hidden="true" width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={icons[s.icon]}></svg></span>
</div>
</div>
</section>

<section class="sec" style="background: #FFFFFF">
<div class="wrap" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(420px, 100%), 1fr)); gap: 28px">
<div style="background: #F0F2FF; border-radius: 24px; padding: 36px; display: flex; flex-direction: column; gap: 14px">
<h2 class="h3" style="color: #001C44; font-size: 24px">Who it's for</h2>
{s.bestFor.map((b) => <p style="margin: 0; display: flex; gap: 10px"><Fragment set:html={check} />{b}</p>)}
</div>
<div style="background: #001C44; color: #FFFFFF; border-radius: 24px; padding: 36px; display: flex; flex-direction: column; gap: 14px">
<h2 class="h3" style="color: #FFFFFF; font-size: 24px">Signs you need it</h2>
{s.signs.map((b) => <p style="margin: 0; display: flex; gap: 10px; color: #CBD1D9"><Fragment set:html={dot} />{b}</p>)}
</div>
</div>
</section>

<section class="sec" style="background: #F9FAFF">
<div class="wrap" style="display: flex; flex-direction: column; gap: 44px">
<div style="display: flex; flex-direction: column; gap: 12px; max-width: 760px">
<h2 class="h2" style="color: #001C44">Everything in the {s.menuLabel} service.</h2>
</div>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr)); gap: 20px">
{s.included.map((i) => (
<div style="background: #FFFFFF; border: 1px solid #DDE1FF; border-radius: 20px; padding: 28px; display: flex; flex-direction: column; gap: 10px">
<h3 class="h3" style="color: #001C44; font-size: 19px; display: flex; gap: 10px"><Fragment set:html={check} />{i.title}</h3>
<p style="margin: 0; font-size: 16px">{i.text}</p>
</div>
))}
</div>
</div>
</section>

<section class="sec" style="background: #FFFFFF">
<div class="wrap" style="display: flex; flex-wrap: wrap; gap: 48px; align-items: flex-start">
<div style="flex: 2 1 560px; min-width: 0; display: flex; flex-direction: column; gap: 32px">
<div style="display: flex; flex-direction: column; gap: 12px">
<h2 class="h2" style="color: #001C44">From audit to results.</h2>
</div>
<ol style="list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr)); gap: 24px">
{s.process.map((p, i) => (
<li style={`display: flex; flex-direction: column; gap: 10px; border-top: 4px solid ${i === s.process.length - 1 ? '#FFCA00' : '#3354FF'}; padding-top: 20px`}>
<span style="font-family: Archivo, system-ui, sans-serif; font-weight: 800; font-size: 34px; color: #DDE1FF; line-height: 1">{String(i + 1).padStart(2, '0')}</span>
<h3 class="h3" style="color: #001C44">{p.title}</h3>
<p style="margin: 0; font-size: 16px">{p.text}</p>
</li>
))}
</ol>
</div>
<div style="flex: 1 1 320px; min-width: 0; background: #F0F2FF; border-radius: 24px; padding: 32px; display: flex; flex-direction: column; gap: 16px">
<p style="margin: 0; font-size: 13px; font-weight: 700; color: #3354FF; text-transform: uppercase; letter-spacing: 0.08em">What you get</p>
{s.deliverables.map((d) => <p style="margin: 0; color: #001C44; font-weight: 600">{d}</p>)}
<a class="pill" href={CALENDLY} target="_blank" rel="noopener" style="background: #3354FF; color: #FFFFFF; align-self: flex-start; margin-top: 6px">Book a Strategy Call</a>
</div>
</div>
</section>

{cases.length > 0 && (
<section class="sec" style="background: #F9FAFF">
<div class="wrap" style="display: flex; flex-direction: column; gap: 36px">
<div style="display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 20px">
<div style="display: flex; flex-direction: column; gap: 12px">
<h2 class="h2" style="color: #001C44">{s.menuLabel} results.</h2>
</div>
<a href="/results/" style="font-weight: 700; text-decoration: none">All case studies →</a>
</div>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(420px, 100%), 1fr)); gap: 24px">
{cases.map((c) => (
<a href={`/results/${c.id}/`} style="text-decoration: none; color: inherit; background: #FFFFFF; border: 1px solid #DDE1FF; border-radius: 24px; padding: 28px; display: flex; flex-direction: column; gap: 12px">
<div style="display: flex; flex-wrap: wrap; gap: 8px">{c.data.tags.map((t) => <span class="tag">{t}</span>)}</div>
<p style="margin: 0; font-family: Archivo, system-ui, sans-serif; font-weight: 800; font-size: 44px; line-height: 1; color: #3354FF">{c.data.metric}</p>
<h3 class="h3" style="color: #001C44">{c.data.cardTitle}</h3>
<p style="margin: 0; font-size: 15px">{c.data.cardMeta}</p>
<span style="font-weight: 700; color: #3354FF; font-size: 15px">Read case study →</span>
</a>
))}
</div>
</div>
</section>
)}

<section class="sec" style="background: #FFFFFF">
<div class="wrap" style="display: flex; flex-wrap: wrap; gap: 48px">
<div style="flex: 1 1 300px; min-width: 0; display: flex; flex-direction: column; gap: 12px">
<h2 class="h2" style="color: #001C44">{s.menuLabel} questions.</h2>
</div>
<div style="flex: 2 1 560px; min-width: 0; display: flex; flex-direction: column; gap: 12px">
{s.faqs.map((f) => <div class="q"><h3>{f.q}</h3><p>{f.a}</p></div>)}
</div>
</div>
</section>

{guides.length > 0 && (
<section style="background: #FFFFFF; border-top: 1px solid #EEF0FF">
<div class="wrap" style="display: flex; flex-direction: column; gap: 24px; padding-top: 64px; padding-bottom: 16px">
<h2 class="h3" style="color: #001C44; font-size: 24px">Guides on this topic</h2>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr)); gap: 16px">
{guides.map((g) => (
<a href={`/blog/${g.id}/`} style="text-decoration: none; background: #F9FAFF; border: 1px solid #DDE1FF; border-radius: 18px; padding: 22px; display: flex; flex-direction: column; gap: 8px">
<span style="font-size: 13px; font-weight: 700; color: #3354FF; text-transform: uppercase; letter-spacing: .04em">{g.data.category}</span>
<span style="font-family: Archivo, system-ui, sans-serif; font-weight: 800; font-size: 18px; line-height: 1.3; color: #001C44">{g.data.title}</span>
<span style="font-size: 15px; color: #334969">{g.data.description}</span>
</a>
))}
</div>
</div>
</section>
)}

<section style="background: #F9FAFF; border-top: 1px solid #EEF0FF">
<div class="wrap" style="display: flex; flex-direction: column; gap: 24px; padding-top: 64px; padding-bottom: 64px">
<h2 class="h3" style="color: #001C44; font-size: 24px">Other services</h2>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr)); gap: 16px">
{others.map((o) => (
<a href={`/services/${o.slug}/`} style="text-decoration: none; background: #FFFFFF; border: 1px solid #DDE1FF; border-radius: 18px; padding: 22px; display: flex; align-items: center; gap: 14px; color: #001C44; font-weight: 700">
<span style="flex: none; display: inline-flex; width: 44px; height: 44px; border-radius: 12px; background: #3354FF; align-items: center; justify-content: center"><svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={icons[o.icon]}></svg></span>
{o.name} →
</a>
))}
</div>
</div>
</section>

<section style="background: #3354FF; color: #FFFFFF">
<div class="wrap" style="display: flex; flex-direction: column; align-items: center; text-align: center; gap: 18px; padding-top: 88px; padding-bottom: 88px">
<h2 class="h2" style="color: #FFFFFF; max-width: 760px">Not sure this is the right service? Let's talk it through.</h2>
<a class="pill" href={CALENDLY} target="_blank" rel="noopener" style="background: #FFCA00; color: #001C44; margin-top: 6px">Book a Free Strategy Call</a>
</div>
</section>
</BaseLayout>

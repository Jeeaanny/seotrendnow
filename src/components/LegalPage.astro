---
import BaseLayout from '../layouts/BaseLayout.astro';
interface Props { title: string; heading: string; description: string; updated: string; path: string; name: string }
const { title, heading, description, updated, path, name } = Astro.props;
const css = `.h1{font-family:Archivo,system-ui,sans-serif;font-weight:800;font-size:52px;line-height:1.05;letter-spacing:-0.02em;margin:0}@media(max-width:820px){.h1{font-size:36px}}`;
---
<BaseLayout title={title} description={description} breadcrumb={[{ name, url: path }]}>
<Fragment slot="head"><style is:inline set:html={css}></style></Fragment>
<section style="background: #F9FAFF; border-bottom: 1px solid #EEF0FF">
  <div class="wrap" style="padding-top: 72px; padding-bottom: 48px; max-width: 880px; display: flex; flex-direction: column; gap: 14px">
    <h1 class="h1" style="color: #0B2A6F">{heading}</h1>
    <p style="margin: 0; font-size: 15px">Last updated: {updated}</p>
  </div>
</section>
<div class="wrap" style="max-width: 880px; padding-top: 48px; padding-bottom: 96px">
  <div class="prose"><slot /></div>
</div>
</BaseLayout>

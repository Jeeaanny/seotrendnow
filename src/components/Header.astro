---
import { NAV, CALENDLY, SITE } from '../consts';
import Logo from './Logo.astro';
const path = Astro.url.pathname;
const isOn = (href: string) => path === href || path.startsWith(href);
---
<a class="skip" href="#main">Skip to content</a>
<header class="site-header">
  <div class="wrap bar">
    <a href="/" class="brand" aria-label={`${SITE.name} home`}>
      <Logo />
      <span class="brand-name">SEOTrend<span>Now</span></span>
    </a>
    <nav class="navlinks" aria-label="Main">
      {NAV.map((n) => (
        <a class:list={['navlink', { on: isOn(n.href) }]} href={n.href} aria-current={isOn(n.href) ? 'page' : undefined}>{n.label}</a>
      ))}
    </nav>
    <a class="pill header-cta" href={CALENDLY} target="_blank" rel="noopener">Book a Strategy Call</a>
    <button class="burger" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-nav" id="burger">
      <svg class="ico-open" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
      <svg class="ico-close" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
    </button>
  </div>
  <nav class="mobile-nav" id="mobile-nav" aria-label="Mobile" hidden>
    {NAV.map((n) => (
      <a class:list={[{ on: isOn(n.href) }]} href={n.href} aria-current={isOn(n.href) ? 'page' : undefined}>{n.label}</a>
    ))}
    <a class="pill" href={CALENDLY} target="_blank" rel="noopener">Book a Strategy Call</a>
  </nav>
</header>
<script>
  const btn = document.getElementById('burger');
  const menu = document.getElementById('mobile-nav');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    btn.setAttribute('aria-label', open ? 'Open menu' : 'Close menu');
    if (menu) menu.hidden = open;
  });
</script>

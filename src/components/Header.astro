---
import { NAV, CALENDLY, SITE, SERVICES, INDUSTRIES } from '../consts';
import Logo from './Logo.astro';
const path = Astro.url.pathname;
const isOn = (href: string) => path === href || path.startsWith(href) || (href === '/services/' && path.startsWith('/industries/'));
const chevron = '<svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>';
---
<a class="skip" href="#main">Skip to content</a>
<header class="site-header">
  <div class="wrap bar">
    <a href="/" class="brand" aria-label={`${SITE.name} home`}>
      <Logo />
      <span class="brand-name">SEOTrend<span>Now</span></span>
    </a>
    <nav class="navlinks" aria-label="Main">
      {NAV.map((n) =>
        n.href === '/services/' ? (
          <div class="has-menu">
            <a class:list={['navlink', 'menu-trigger', { on: isOn(n.href) }]} href={n.href} aria-current={path === n.href ? 'page' : undefined} aria-haspopup="true">
              {n.label}<Fragment set:html={chevron} />
            </a>
            <div class="menu" role="menu" aria-label="Services">
              {SERVICES.map((s) => (
                <a role="menuitem" class:list={{ on: path === `/services/${s.slug}/` }} href={`/services/${s.slug}/`}>{s.label}</a>
              ))}
              <span class="menu-label" aria-hidden="true">By industry</span>
              {INDUSTRIES.map((s) => (
                <a role="menuitem" class:list={{ on: path === `/industries/${s.slug}/` }} href={`/industries/${s.slug}/`}>{s.label}</a>
              ))}
              <a role="menuitem" class="menu-all" href="/services/">All services →</a>
            </div>
          </div>
        ) : (
          <a class:list={['navlink', { on: isOn(n.href) }]} href={n.href} aria-current={isOn(n.href) ? 'page' : undefined}>{n.label}</a>
        )
      )}
    </nav>
    <a class="pill header-cta" href={CALENDLY} target="_blank" rel="noopener">Book a Strategy Call</a>
    <button class="burger" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-nav" id="burger">
      <svg class="ico-open" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
      <svg class="ico-close" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
    </button>
  </div>
  <nav class="mobile-nav" id="mobile-nav" aria-label="Mobile" hidden>
    {NAV.map((n) =>
      n.href === '/services/' ? (
        <details class="m-sub" open={isOn('/services/')}>
          <summary class:list={{ on: isOn('/services/') }}>Services<Fragment set:html={chevron} /></summary>
          <div class="m-sub-links">
            <a href="/services/" class:list={{ on: path === '/services/' }}>All services</a>
            {SERVICES.map((s) => <a href={`/services/${s.slug}/`} class:list={{ on: path === `/services/${s.slug}/` }}>{s.label}</a>)}
            {INDUSTRIES.map((s) => <a href={`/industries/${s.slug}/`} class:list={{ on: path === `/industries/${s.slug}/` }}>{s.label}</a>)}
          </div>
        </details>
      ) : (
        <a class:list={[{ on: isOn(n.href) }]} href={n.href} aria-current={isOn(n.href) ? 'page' : undefined}>{n.label}</a>
      )
    )}
    <a class="pill" href={CALENDLY} target="_blank" rel="noopener">Book a Strategy Call</a>
  </nav>
</header>
<script>
  const btn = document.getElementById('burger');
  const menu = document.getElementById('mobile-nav');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    btn.setAttribute('aria-label', open ? 'Open menu' : 'Close menu');
    if (menu) menu.hidden = open;
  });
  // Close the desktop dropdown with Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && document.activeElement instanceof HTMLElement && document.activeElement.closest('.has-menu')) {
      document.activeElement.blur();
    }
  });
</script>
